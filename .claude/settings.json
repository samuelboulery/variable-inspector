{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run test)",
      "Bash(npm run test:watch)",
      "Bash(npm run test:cov)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(graphify:*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(rm -rf*)",
      "Bash(npm install*)"
    ]
  }
}
